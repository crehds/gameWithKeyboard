{
  "name": "gamewithkeyboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A keyboard-based memory game in the style of Simon.",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^4.2.0",
    "styled-components": "^6.5.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
